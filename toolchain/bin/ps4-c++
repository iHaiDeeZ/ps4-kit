#!/usr/bin/env bash
# Compiler wrapper for autotools/meson builds: compiles for PS4 and, when
# asked to link, produces a PS4 executable with the OpenOrbis runtime.
# (ps4-c++ is the same script: the name picks C++.)
HERE="$(dirname "$(readlink -f "$0")")"
source "$HERE/../env.sh"

lang_cxx=0
[[ "$(basename "$0")" == *++ ]] && lang_cxx=1

compile_only=0
for a in "$@"; do
    case "$a" in -c|-E|-S|-M|-MM|--version|-dumpversion|-dumpmachine|-print-*) compile_only=1 ;; esac
done
# xemu: a bare -v prints the version; with inputs it's verbose (CMake links its ABI probe with -v,
# which then skipped the PS4 link and failed)
[ "$*" = "-v" ] && compile_only=1

cxxflags=()
if (( lang_cxx )); then
    cxxflags=(-nostdinc++ -isystem "$PS4_SYSROOT/include/c++/v1")
    cc="$PS4_CXX"
else
    cc="$PS4_CC"
fi
# shellcheck disable=SC2206
base=($PS4_BASE_FLAGS -isystem "$PS4_SYSROOT/include")

if (( compile_only )) || (( $# == 0 )); then
    exec "$cc" "${cxxflags[@]}" "${base[@]}" "$@"
fi

# xemu: shared libraries (meson builds some alongside the static ones, e.g. libslirp): the PS4
# program links the static ones and never loads a .so, so the target is only an empty file
for a in "$@"; do
    if [ "$a" = -shared ]; then
        out=""; prev=""
        for b in "$@"; do [ "$prev" = -o ] && out="$b"; prev="$b"; done
        [ -n "$out" ] && : > "$out"
        exit 0
    fi
done

libs=()
if (( lang_cxx )); then
    libs=("$PS4_SYSROOT/lib/libc++.a" "$PS4_SYSROOT/lib/libc++abi.a" "$OPENORBIS/lib/libunwind.a")
fi
# A port's own app link through this wrapper (xemu's scripts/build-xemu.sh) brings its runtime:
#   PS4_CRT1             crt1.o to start from (the kit's malloc-replacing runtime/ps4_crt1.S)
#   PS4_APP_LDFLAGS      after the inputs: the runtime's objects, RADV, system libraries, --wrap flags
#   PS4_APP_LDFLAGS_END  searched last (e.g. a libc's ENOSYS stubs)
#   PS4_RT_LIB           the malloc library next to the C library (build-runtime.sh's); PS4_RT_LIB=
#                        (empty) for none: no PSChrome malloc next to an app's own heap
#   PS4_LINK_SCRIPT      the linker script (default: toolchain/ps4-link.x)
rt_lib="${PS4_RT_LIB-$PS4_SYSROOT/lib/libdolphinps4_rt.a}"
# shellcheck disable=SC2086
exec "$cc" "${cxxflags[@]}" "${base[@]}" -fuse-ld=lld -nostdlib -Wl,--no-dynamic-linker -Wl,-m,elf_x86_64 -Wl,-pie \
    -Wl,--script,"${PS4_LINK_SCRIPT:-$HERE/../ps4-link.x}" -Wl,--eh-frame-hdr \
    "${PS4_CRT1:-$OPENORBIS/lib/crt1.o}" "$OPENORBIS/lib/crti.o" \
    -L"$PS4_SYSROOT/lib" -L"$OPENORBIS/usr/lib" -L"$OPENORBIS/lib" \
    "$@" ${PS4_APP_LDFLAGS:-} \
    -Wl,--start-group "${libs[@]}" ${rt_lib:+"$rt_lib"} -lkernel -lc -lSceLibcInternal "$OPENORBIS/lib/libclang_rt.builtins-x86_64.a" -Wl,--end-group \
    ${PS4_APP_LDFLAGS_END:-} "$OPENORBIS/lib/crtn.o"
